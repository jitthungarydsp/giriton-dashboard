+    return result
+
+
+def update_group_overrides(snapshot, clean, note):
+    """Persist edits independently of the imported financial base."""
+    previous = source_payload(snapshot, "pwa_worksheet_overrides")
+    overrides = deepcopy(previous) if isinstance(previous, dict) else {"version": 1, "groups": []}
+    indexed = {g["key"]: g for g in overrides["groups"]}
+    old_groups = {g["key"]: g for g in worksheet_groups(snapshot)}
+    for group in clean:
+        patch = indexed.setdefault(group["key"], {"key": group["key"], "removed": [], "added": []})
+        before = {r["id"]: r for r in old_groups[group["key"]]["items"]}
+        after = {r["id"]: r for r in group["items"]}
+        for ident in sorted(before.keys() - after.keys()):
+            if any(r["id"] == ident for r in patch["added"]):
+                patch["added"] = [r for r in patch["added"] if r["id"] != ident]
+            else:
+                patch["removed"].append(deepcopy(before[ident]))
+        patch["added"].extend(deepcopy(after[ident]) for ident in sorted(after.keys() - before.keys()))
+    overrides["groups"] = [indexed[key] for key in EDIT_GROUPS]
+    overrides["note"] = str(note).strip()
+    return overrides
+
+
+def _entry_signature(row):
+    return (str(row.get("label") or "").strip(), str(row.get("note") or "").strip(), int(row["amountHuf"]))
+
+
+def carry_forward_worksheet_changes(candidate, previous):
+    """Rebase manual additions/deletions on a new import. Never reuse old base fees."""
+    patch = source_payload(previous, "pwa_worksheet_overrides")
+    legacy_groups = source_payload(previous, "pwa_worksheet_group_items")
+    if patch is None and legacy_groups is None:
+        return deepcopy(candidate)
+    if str(previous.get("courier_id")) != str(candidate.get("courier_id")) or str(previous.get("period_start"))[:10] != str(candidate.get("period_start"))[:10]:
+        raise ValueError("A kézi módosítás másik futárhoz vagy hónaphoz tartozik.")
+    if source_payload(candidate, "pwa_worksheet_group_items") is not None:
+        # Reserve movements already operate on the published effective ledger.
+        # They must name its version and preserve every edited component.
+        if str((candidate.get("metadata") or {}).get("worksheet_effective_base_snapshot_id") or "") != str(previous["id"]):
+            raise ValueError("A már módosított elszámolás alapverziója eltér. Töltsd újra az adatokat.")
+        if (source_payload(candidate, "pwa_worksheet_group_items") != legacy_groups
+                or source_payload(candidate, "pwa_worksheet_overrides") != patch):
+            raise ValueError("A művelet nem írhatja át a PWA tételmódosításait.")
+        keys = {k for _, components, _ in EDIT_GROUPS.values() for k in components} | {"kiflis_bonus_malus", "bonus_malus", "correction"}
+        def amounts(saved):
+            return {i["item_key"]: i["amount_value"] for i in saved["items"] if i.get("section") == "finance" and i["item_key"] in keys}
+        if amounts(candidate) != amounts(previous):
+            raise ValueError("A művelet nem módosíthatja a PWA-ban kezelt pénzügyi csoportokat.")
+        effective = deepcopy(candidate)
+        effective["metadata"]["worksheet_import_source"] = effective["metadata"].get("source")
+        effective["metadata"]["source"] = "pwa_worksheet_pilot"
+        return effective
+    groups = worksheet_groups(candidate)
+    if patch is None:
+        # Earlier versions retained only the final ledger. Preserve that ledger
+        # until its changes can be explicitly reviewed rather than losing it.
+        groups = deepcopy(legacy_groups)
+    else:
+        if patch.get("version") != 1 or {g["key"] for g in patch.get("groups", [])} != set(EDIT_GROUPS):
+            raise ValueError("Ismeretlen kézi módosításformátum; az előző snapshot megmarad.")
+        patches = {g["key"]: g for g in patch["groups"]}
+        for group in groups:
+            current = list(group["items"])
+            for removed in patches[group["key"]]["removed"]:
+                matches = [n for n, row in enumerate(current) if _entry_signature(row) == _entry_signature(removed)]
+                if matches:
+                    current.pop(matches[0])  # Multiset: one deletion removes one occurrence.
+                elif any(_entry_signature(row)[:2] == _entry_signature(removed)[:2] for row in current):
+                    raise ValueError("Egy korábban kivett tétel összege megváltozott az importban. Ellenőrzés szükséges; az előző snapshot megmarad.")
+            current.extend(deepcopy(patches[group["key"]]["added"]))
+            if len({r["id"] for r in current}) != len(current):
+                raise ValueError("Az import és a kézi tételek azonosítói ütköznek.")
+            group["items"] = current
+    note = str((patch or {}).get("note") or "Korábbi PWA tételmódosítások megőrzése")
+    result = prepare_group_worksheet(candidate, groups, note)["prepared"]
+    if patch is not None:
+        saved_patch = next(s for s in result["sources"] if s["source_key"] == "pwa_worksheet_overrides")
+        saved_patch["payload"] = deepcopy(patch)
+        saved_patch["row_count"] = sum(len(g["removed"]) + len(g["added"]) for g in patch["groups"])
+    result["metadata"]["worksheet_rebased_from_snapshot_id"] = str((previous.get("metadata") or {}).get("worksheet_rebased_from_snapshot_id") or previous["id"])
+    result["metadata"]["worksheet_import_source"] = (candidate.get("metadata") or {}).get("source")
+    return {**deepcopy(candidate), **result}
