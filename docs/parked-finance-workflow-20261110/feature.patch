+                    raise ValueError("Az új tételhez megnevezés, indok és nem nulla egész forint szükséges.")
+                entries.append({"id": ident, "label": str(row["label"]).strip(), "note": str(row["note"]).strip(), "amountHuf": amount})
+        clean.append({"key": key, "label": EDIT_GROUPS[key][0], "items": entries})
+    working = deepcopy(snapshot)
+    working["sources"] = [s for s in working.get("sources", []) if s["source_key"] not in
+                          {"pwa_worksheet_audit", "pwa_worksheet_manual_rows", "pwa_worksheet_group_items", "pwa_worksheet_overrides"}]
+    remove = {k for _, components, _ in EDIT_GROUPS.values() for k in components} | {"kiflis_bonus_malus", "bonus_malus", "correction"}
+    prefixes = tuple(p for _, _, pp in EDIT_GROUPS.values() for p in pp)
+    working["items"] = [i for i in working["items"] if i.get("section") != "finance" or
+                        (i["item_key"] not in remove and not i["item_key"].startswith(prefixes))]
+    for group in clean:
+        for side, component in enumerate(EDIT_GROUPS[group["key"]][1]):
+            amount = sum(i["amountHuf"] for i in group["items"] if (i["amountHuf"] >= 0) == (side == 0))
+            working["items"].append({"section": "finance", "item_key": component, "item_label": component, "amount_value": amount, "amount_kind": "huf"})
+    result = prepare_worksheet(working, [], [], note)
+    prepared = result["prepared"]
+    saved_keys = {(i["section"], i["item_key"]) for i in prepared["items"]}
+    for item in working["items"]:
+        if (item["section"], item["item_key"]) not in saved_keys and item["section"] != "tig":
+            prepared["items"].append({k: deepcopy(item.get(k)) for k in
+                                     ("section", "item_key", "item_label", "amount_value", "amount_kind", "note", "display_order")})
+    prepared["sources"].append({"source_key": "pwa_worksheet_group_items", "payload": clean,
+                                 "row_count": sum(len(g["items"]) for g in clean), "source_table": "pwa_finance_worksheet"})
+    overrides = update_group_overrides(snapshot, clean, note)
+    prepared["sources"].append({"source_key": "pwa_worksheet_overrides", "payload": overrides,
+                                 "row_count": sum(len(g["removed"]) + len(g["added"]) for g in overrides["groups"]),
+                                 "source_table": "pwa_finance_worksheet"})
+    # Both applications render the authoritative ledger rather than old import details.
+    drilldowns = source_payload(prepared, "card_drilldowns")
+    for group in clean:
