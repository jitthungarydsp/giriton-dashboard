--- /dev/null
+++ b/tests/test_finance_snapshot_persistence_sql.cjs
@@ -0,0 +1,81 @@
+// Isolated PostgreSQL test: no production credentials or data.
+const {PGlite} = require(process.env.PGLITE_MODULE || '@electric-sql/pglite');
+const {readFileSync} = require('node:fs');
+const assert = require('node:assert/strict');
+function prepared(base, edited) {
+  const values = {base, tip:20000, monthly_bonus:1000, monthly_malus:edited?0:-500,
+    manual_bonus:edited?3500:1000, manual_malus:0, customer_rating:5000,
+    correction_income:10000, correction_deduction:-1000};
+  const income = base + 20000 + 1000 + values.manual_bonus + 5000;
+  const payable = income + values.monthly_malus + 9000;
+  Object.assign(values,{income,deductions:values.monthly_malus,correction:9000,payable,
+    kiflis_bonus_malus:1000+values.monthly_malus,bonus_malus:values.manual_bonus});
+  const row = (key,amount,section='finance') => ({section,item_key:key,item_label:key,amount_value:amount,amount_kind:'huf',display_order:1,note:''});
+  const result = {items:Object.entries(values).map(([k,v])=>row(k,v)),sources:[],metadata:{
+    income_total:income,deduction_total:values.monthly_malus,correction_total:9000,payable_total:payable,
+    tig_final_total:payable,source:edited?'pwa_worksheet_pilot':'devtest.bulk_finance_snapshot',
+    worksheet_courier_id:'12345',worksheet_period_start:'2026-09-01',worksheet_note:'Egyeztetés'}};
+  result.items.push(row('tig_service',payable,'tig'),row('tig_final_total',payable,'tig'));
+  if(edited) {
+    const entry = (id,amountHuf) => ({id,label:id,amountHuf,note:'Indok'});
+    const groups = [
+      {key:'kiflis_bonus_malus',label:'Kifli',items:[entry('monthly_bonus',1000)]},
+      {key:'bonus_malus',label:'JITT',items:[entry('manual_bonus',1000),entry('new-1',2500)]},
+      {key:'corrections',label:'Korrekció',items:[entry('correction_income',10000),entry('correction_deduction',-1000)]}];
+    const patch = {version:1,note:'Egyeztetés',groups:[
+      {key:'kiflis_bonus_malus',removed:[entry('monthly_malus',-500)],added:[]},
+      {key:'bonus_malus',removed:[],added:[entry('new-1',2500)]},
+      {key:'corrections',removed:[],added:[]}]};
+    result.sources.push({source_key:'pwa_worksheet_overrides',payload:patch,row_count:2,source_table:'test'},
+      {source_key:'pwa_worksheet_group_items',payload:groups,row_count:5,source_table:'test'});
+  }
+  return result;
+}
+const fixture = {raw:prepared(100000,false),pwa:prepared(100000,true),reimport:prepared(110000,true)};
+(async () => {
+  const db = new PGlite();
+  let checked = 0;
+  try {
+    await db.exec(`create role anon; create role authenticated; create role service_role;
+      create schema settlement;
+      create table settlement.courier_monthly_closure(courier_id text,period_start date,status text);
+      create table public.peopleforce_card_statuses(courier_id text,document_month date,action_key text,status text);`);
+    await db.exec(readFileSync('sql/settlement_courier_finance_snapshot.sql','utf8').replace(/^\uFEFF/,''));
+    await db.exec(readFileSync('sql/pwa_finance_worksheet_pilot.sql','utf8').replace(/^\uFEFF/,''));
+    const migration = readFileSync('sql/finance_snapshot_preserve_pwa.sql','utf8').replace(/^\uFEFF/,'');
+    await db.exec(migration); await db.exec(migration);
+    const header = {courier_name:'Teszt',calculation_mode:'Excel',warehouse_label:'BUD1',session_id:'new-excel-session'};
+    const publish = async (base, hash, prepared) => (await db.query(`select settlement.commit_imported_finance_snapshot($1,$2,$3,$4,$5,$6::jsonb,$7::jsonb) as result`,
+      ['12345','2026-09-01',base,hash,'admin',JSON.stringify(header),JSON.stringify(prepared)])).rows[0].result;
+    const first = await publish(null,'import-1',fixture.raw);
+    assert.equal(first.version,1); checked++;
+    const edited = (await db.query(`select settlement.pwa_commit_worksheet_pilot($1,$2,$3,$4,$5,$6::jsonb) as result`,
+      ['12345','2026-09-01',first.snapshotId,'pwa-2','admin',JSON.stringify(fixture.pwa)])).rows[0].result;
+    assert.equal(edited.version,2); checked++;
+    await assert.rejects(publish(first.snapshotId,'stale-import',fixture.reimport),/verziója megváltozott/); checked++;
+    const imported = await publish(edited.snapshotId,'import-3',fixture.reimport);
+    assert.equal(imported.version,3);
+    assert.equal((await db.query('select session_id from settlement.courier_finance_snapshot where id=$1',[imported.snapshotId])).rows[0].session_id,header.session_id);
