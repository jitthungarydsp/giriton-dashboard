diff --git a/tests/test_worksheet_group_editor.cjs b/tests/test_worksheet_group_editor.cjs
new file mode 100644
--- /dev/null
+++ b/tests/test_worksheet_group_editor.cjs
@@ -0,0 +1,29 @@
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const vm = require('node:vm');
+const source = fs.readFileSync('pwa/app.js', 'utf8');
+function get(name) {
+  const start = source.indexOf(`function ${name}(`);
+  const end = source.indexOf('\nfunction ', start + 1);
+  return source.slice(start, end);
+}
+const context = {escapeHtml: String, formatHuf: n => `${n} Ft`};
+vm.createContext(context);
+vm.runInContext(get('settlementDashboardPilotFinanceEditor') + '\n' + get('settlementLedgerRow'), context);
+test('editor exposes only three ledgers and locks saved entries', () => {
+  const html = context.settlementDashboardPilotFinanceEditor({snapshotId:'s', courierId:'1', month:'2026-10', version:1,
+    rows:[{key:'base', amountHuf:100000}], savedTotal:100000,
+    groups:['kiflis_bonus_malus','bonus_malus','corrections'].map(key => ({key,label:key,items:[{id:'old',label:'Saved',amountHuf:100,note:'reason'}]}))});
+  assert.equal((html.match(/data-ledger-group=/g)||[]).length, 3);
+  assert.equal((html.match(/data-ledger-add/g)||[]).length, 3);
+  assert.equal((html.match(/readonly/g)||[]).length, 9);
+  assert.doesNotMatch(html, /data-worksheet-key|data-manual-field/);
+});
+test('new entries allow amount and reason input and removal', () => {
+  const html = context.settlementLedgerRow();
+  assert.doesNotMatch(html, /readonly/);
+  assert.match(html, /data-ledger-field="amountHuf"/);
+  assert.match(html, /data-ledger-field="note"/);
+  assert.match(html, /data-dashboard-editor-delete/);
+});
