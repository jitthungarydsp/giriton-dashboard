+class GroupWorksheetTest(unittest.TestCase):
+    def test_add_remove_reopen_preserves_unrelated_amounts(self):
+        saved = snapshot()
+        groups = worksheet_groups(saved)
+        groups[0]["items"] = [i for i in groups[0]["items"] if i["amountHuf"] >= 0]
+        groups[1]["items"].append({"id": "new-bonus", "label": "Extra", "amountHuf": 2500, "note": "Indok"})
+        result = prepare_group_worksheet(saved, groups, "Tételek javítása")
+        self.assertEqual(result["delta"], 3000)
+        values = {i["item_key"]: i["amount_value"] for i in result["prepared"]["items"] if i["section"] == "finance"}
+        self.assertEqual(values["base"], 100000)
+        self.assertEqual(values["tip"], 20000)
+        reopened = {**saved, **result["prepared"], "id": "new-id", "version": 11}
+        again = prepare_group_worksheet(reopened, worksheet_groups(reopened), "Újramentés")
+        self.assertEqual(again["delta"], 0)
+        self.assertEqual(again["totals"], result["totals"])
+
+    def test_unrelated_saved_detail_is_preserved(self):
+        saved = snapshot()
