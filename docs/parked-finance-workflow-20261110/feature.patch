@@ -0,0 +1,64 @@
+# PWA tételmódosítások megőrzése új importnál
+
+A PWA, a devtest oldalsávja és a pénzügyi részletező ugyanazt a legfrissebb
+`settlement.courier_finance_snapshot` verziót olvassa futáronként és hónaponként.
+A PWA mentése az összesítőket, a TIG-bontást és a tétellistát együtt menti.
+Meglévő PDF-et ez nem generál újra.
+
+## A kézi módosítások megőrzése
+
+A snapshot forrásai között a `pwa_worksheet_group_items` a megjelenített tétellista,
+a `pwa_worksheet_overrides` pedig a kézi hozzáadások és kivételek naplója.
+Az új Excel/API számítás friss alapadatokat szolgáltat; a napló változásai ezekre
+kerülnek rá. Az ismételt import nem adja hozzá még egyszer a kézi tételeket.
+A kézi tétel későbbi kivétele az importokból is eltávolítja ezt a hozzáadást.
+
+A kivett importtételeket a megnevezés, indok és összeg alapján egyeztetjük,
+nem az Excel változó sorszáma alapján. Azonos tételekből egy kivétel egy
+előfordulást távolít el. Az importból már hiányzó tétel kivétele megmarad a
+naplóban, így egy későbbi feltöltés sem hozza vissza.
+Ha ugyanaz a megnevezés/indok eltérő összeggel jelenik meg, a publikálás megáll:
+az előző teljes snapshot marad érvényben, és az import eredményében megjelenik
+az ellenőrzést kérő hiba. Új, eltérő tételeket az import továbbra is hozzáadhat.
+
+Korábbi, csak végleges tétellistát tartalmazó PWA-verziónál a teljes három
+csoportot megőrizzük: a rendszer nem találja ki utólag az elveszett változásnaplót.
+Ilyen elszámolásnál az új import csoporttételeit külön ellenőrizni kell.
+
+## Mentés és verzióvédelem
+
+A devtest összes snapshot-publikálása és a korábbi admin-szerkesztő a közös
+`resources/finance_snapshot_persistence.py` mentési pontot használja.
+Az új `settlement.commit_imported_finance_snapshot` RPC egy tranzakcióban menti
+a verziót, a tételeket és a forrásokat. Ugyanazt a futár/hónap zárolást használja,
+mint a PWA munkalapja. Elavult alapverzió, lezárt kifizetés vagy hiányzó/módosult
+PWA-napló esetén nincs mentés és nincs automatikus újrapróbálás.
+Az import hibája a futár eredményében látszik; nem írunk részleges új verziót.
+
+A céltartalék-mozgás már a végleges snapshotból indul, ezért megadja annak
+azonosítóját: ilyenkor a PWA-tételeket nem alkalmazzuk másodszor.
+A devtest „Mentett PWA módosítások frissítése” gombja csak a mentett adatokat
+olvassa újra; nem indít új számítást vagy Excel-importot.
+
+## Élesítési sorrend
+
+1. Ha még nincs telepítve, futtasd a `sql/pwa_finance_worksheet_pilot.sql` fájlt.
+2. Futtasd a `sql/finance_snapshot_preserve_pwa.sql` migrációt az adatbázisban.
+   A migráció újrafuttatható, meglévő futáradatot nem módosít.
+3. Élesítsd együtt az új PWA/API és devtest kódot.
+
+A migráció nélkül az új import mentési hibát jelez és megtartja az előző
+snapshotot. Nincs visszaesés a régi, kézi módosításokat elveszítő mentésre.
+A helyi tesztek nem módosítják az éles adatbázist.
+
+## Ellenőrzés
+
+- `tests/test_finance_snapshot_persistence.py`: új alapadatok, megőrzött
+  hozzáadás/kivétel, ismételt import, duplikált forrássorok, módosult összeg,
+  céltartalék-mozgás, devtest összegek és tételbontás, atomikus mentés hívása.
+- `tests/test_finance_snapshot_persistence_sql.cjs`: PGlite PostgreSQL-ben
+  közös verziólánc, elveszett napló tiltása, verzióütközés, rollback,
+  összesítések és jogosultságok. Futtatás: `node tests/test_finance_snapshot_persistence_sql.cjs`
+  telepített `@electric-sql/pglite` mellett; külön csomagútvonalhoz `PGLITE_MODULE`.
+- `tests/test_pwa_worksheet_ui.cjs`: helyi, hálózati hívások nélküli böngészőteszt
+  a tényleges eseménykezelőkkel, előnézettel, mentéssel és újranyitással.
diff --git a/sql/finance_snapshot_preserve_pwa.sql b/sql/finance_snapshot_preserve_pwa.sql
new file mode 100644
--- /dev/null
+++ b/sql/finance_snapshot_preserve_pwa.sql
@@ -0,0 +1,92 @@
+-- Run after pwa_finance_worksheet_pilot.sql. Changes no existing courier data.
+-- All import publishers must use this RPC; missing migration fails closed.
+begin;
+create or replace function settlement.commit_imported_finance_snapshot(
+    p_courier_id text, p_period_start date, p_base_snapshot_id uuid,
+    p_fingerprint text, p_actor text, p_header jsonb, p_prepared jsonb
+) returns jsonb language plpgsql security invoker set search_path = pg_catalog
+as $$
+declare
+    v_latest settlement.courier_finance_snapshot%rowtype;
+    v_id uuid;
+    v_patch jsonb;
+    v_next_patch jsonb;
+    v_total numeric;
+begin
+    if nullif(trim(p_courier_id), '') is null or p_period_start is null
+       or p_period_start <> date_trunc('month', p_period_start)::date
+       or nullif(trim(p_actor), '') is null or nullif(p_fingerprint, '') is null
+       or jsonb_typeof(p_prepared->'items') is distinct from 'array'
+       or jsonb_typeof(p_prepared->'sources') is distinct from 'array'
+       or jsonb_typeof(p_prepared->'metadata') is distinct from 'object' then
+        raise exception 'Hiányos pénzügyi snapshot.';
+    end if;
+    perform pg_advisory_xact_lock(hashtextextended('pwa_monthly_payment:' || p_courier_id || ':' || p_period_start, 0));
+    select * into v_latest from settlement.courier_finance_snapshot
+    where courier_id = p_courier_id and period_start = p_period_start
+    order by version desc limit 1 for update;
+    if exists (select 1 from settlement.courier_monthly_closure where courier_id = p_courier_id
+               and period_start = p_period_start and status = 'done')
+       or exists (select 1 from public.peopleforce_card_statuses where courier_id::text = p_courier_id
+                  and document_month = p_period_start and action_key = 'invoice_payment' and status = 'done') then
+        raise exception 'A kifizetés lezárt. Az import nem írhatja át az elszámolást.';
+    end if;
+    if v_latest.fingerprint = p_fingerprint then
+        return jsonb_build_object('ok', true, 'snapshotId', v_latest.id, 'version', v_latest.version, 'unchanged', true);
+    end if;
+    if v_latest.id is distinct from p_base_snapshot_id then
+        raise exception 'Az elszámolás verziója megváltozott. Az importot újra kell számolni.';
+    end if;
+    select payload into v_patch from settlement.courier_finance_snapshot_source
+    where snapshot_id = v_latest.id and source_key = 'pwa_worksheet_overrides';
+    select s->'payload' into v_next_patch from jsonb_array_elements(p_prepared->'sources') s
+    where s->>'source_key' = 'pwa_worksheet_overrides';
+    if v_patch is not null and v_next_patch is distinct from v_patch then
+        raise exception 'Az import nem törölheti és nem írhatja át a PWA módosításait.';
+    end if;
+    if exists (select 1 from settlement.courier_finance_snapshot_source
+               where snapshot_id = v_latest.id and source_key = 'pwa_worksheet_group_items')
+       and not exists (select 1 from jsonb_array_elements(p_prepared->'sources') s
+                       where s->>'source_key' = 'pwa_worksheet_group_items') then
+        raise exception 'Az importból hiányzik a megőrzött PWA tétellista.';
+    end if;
+    if exists (select 1 from jsonb_array_elements(p_prepared->'items') i
+               group by i->>'section', i->>'item_key' having count(*) > 1)
+       or exists (select 1 from jsonb_array_elements(p_prepared->'sources') s
+                  group by s->>'source_key' having count(*) > 1) then
+        raise exception 'Ismétlődő pénzügyi tétel vagy forrás.';
+    end if;
+    v_total := (p_prepared->'metadata'->>'payable_total')::numeric;
+    if v_total is null or v_total is distinct from
+        (p_prepared->'metadata'->>'income_total')::numeric +
+        (p_prepared->'metadata'->>'deduction_total')::numeric +
+        (p_prepared->'metadata'->>'correction_total')::numeric
+       or (select count(*) from jsonb_array_elements(p_prepared->'items') i
+           where i->>'section' = 'tig' and i->>'item_key' = 'tig_final_total'
+             and (i->>'amount_value')::numeric = (p_prepared->'metadata'->>'tig_final_total')::numeric) <> 1
+       or (select count(*) from jsonb_array_elements(p_prepared->'items') i
+        where i->>'section' = 'finance' and i->>'item_key' = 'payable'
+          and (i->>'amount_value')::numeric = v_total) <> 1 then
+        raise exception 'A pénzügyi végösszeg nem egyezik a snapshot tételeivel.';
+    end if;
+    insert into settlement.courier_finance_snapshot
+        (courier_id,courier_name,period_start,version,source,calculation_mode,warehouse_label,session_id,
+         fingerprint,previous_snapshot_id,previous_fingerprint,changed_from_previous,metadata,created_by)
+    values (p_courier_id,coalesce(p_header->>'courier_name',p_courier_id),p_period_start,coalesce(v_latest.version,0)+1,
+            'devtest_finance',p_header->>'calculation_mode',p_header->>'warehouse_label',nullif(p_header->>'session_id',''),
+            p_fingerprint,v_latest.id,v_latest.fingerprint,true,p_prepared->'metadata',p_actor) returning id into v_id;
+    insert into settlement.courier_finance_snapshot_item
+        (snapshot_id,section,item_key,item_label,amount_value,amount_kind,note,display_order)
+    select v_id,x.section,x.item_key,x.item_label,x.amount_value,x.amount_kind,x.note,x.display_order
+    from jsonb_to_recordset(p_prepared->'items') as x(section text,item_key text,item_label text,
+         amount_value numeric,amount_kind text,note text,display_order integer);
+    insert into settlement.courier_finance_snapshot_source (snapshot_id,source_key,source_table,payload,row_count)
+    select v_id,x.source_key,x.source_table,x.payload,x.row_count
+    from jsonb_to_recordset(p_prepared->'sources') as x(source_key text,source_table text,payload jsonb,row_count integer);
+    return jsonb_build_object('ok',true,'snapshotId',v_id,'version',coalesce(v_latest.version,0)+1);
+end;
+$$;
+revoke all on function settlement.commit_imported_finance_snapshot(text,date,uuid,text,text,jsonb,jsonb) from public,anon,authenticated;
+grant execute on function settlement.commit_imported_finance_snapshot(text,date,uuid,text,text,jsonb,jsonb) to service_role;
+notify pgrst, 'reload schema';
+commit;
diff --git a/tests/test_finance_snapshot_persistence.py b/tests/test_finance_snapshot_persistence.py
new file mode 100644
--- /dev/null
+++ b/tests/test_finance_snapshot_persistence.py
@@ -0,0 +1,166 @@
+import ast
+from copy import deepcopy
+from datetime import date
+from pathlib import Path
+from types import SimpleNamespace
+import unittest
+from unittest.mock import Mock
+
+from resources.pwa_finance_worksheet import (worksheet_groups, prepare_group_worksheet,
+    carry_forward_worksheet_changes, source_payload)
+from resources.finance_snapshot_persistence import save_imported_finance_snapshot
+from resources.finance_adjustment_details import snapshot_manual_adjustment_details
+from tests.test_pwa_finance_worksheet import snapshot
+
+
+def edited_snapshot():
+    raw = snapshot()
+    groups = worksheet_groups(raw)
+    groups[0]["items"] = [r for r in groups[0]["items"] if r["amountHuf"] >= 0]
+    groups[1]["items"].append({"id": "new-1", "label": "JITT jutalom", "amountHuf": 2500, "note": "Jóváhagyott jutalom"})
+    result = prepare_group_worksheet(raw, groups, "Egyeztetés")
+    return {**raw, **result["prepared"], "id": "pwa-edit", "version": 11}
+
+
+def values(saved):
+    return {i["item_key"]: i["amount_value"] for i in saved["items"] if i["section"] == "finance"}
+
+
+class ImportOverlayTest(unittest.TestCase):
+    def test_fresh_excel_updates_base_while_preserving_addition_and_removal(self):
+        previous = edited_snapshot()
+        raw = snapshot()
+        next(i for i in raw["items"] if i["item_key"] == "base")["amount_value"] = 110000
+        next(i for i in raw["items"] if i["item_key"] == "tip")["amount_value"] = 21000
+        original = deepcopy(raw)
+        saved = carry_forward_worksheet_changes(raw, previous)
+        self.assertEqual(raw, original)
+        self.assertEqual(values(saved)["base"], 110000)
+        self.assertEqual(values(saved)["tip"], 21000)
+        self.assertEqual(values(saved)["monthly_malus"], 0)
+        self.assertEqual(values(saved)["manual_bonus"], 3500)
+        self.assertEqual(values(saved)["payable"], 149500)
+        self.assertEqual(source_payload(saved, "pwa_worksheet_overrides"), source_payload(previous, "pwa_worksheet_overrides"))
+
+    def test_repeated_import_is_idempotent(self):
+        previous = edited_snapshot()
+        first = carry_forward_worksheet_changes(snapshot(), previous)
+        second = carry_forward_worksheet_changes(snapshot(), {**first, "id": "next-import", "version": 12})
+        self.assertEqual(first["items"], second["items"])
+        self.assertEqual(first["sources"], second["sources"])
+        self.assertEqual(first["metadata"], second["metadata"])
+        self.assertEqual(values(second)["manual_bonus"], 3500)
+
+    def test_new_imported_deduction_is_not_hidden(self):
+        raw = snapshot()
+        next(i for i in raw["items"] if i["item_key"] == "monthly_malus")["amount_value"] = -1500
+        raw["items"].extend([
+            {"section": "finance", "item_key": "kiflis_malus_1", "item_label": "monthly_malus", "amount_value": -500, "amount_kind": "huf"},
+            {"section": "finance", "item_key": "kiflis_malus_2", "item_label": "Új levonás", "amount_value": -1000, "amount_kind": "huf"}])
+        saved = carry_forward_worksheet_changes(raw, edited_snapshot())
+        self.assertEqual(values(saved)["monthly_malus"], -1000)
+
+    def test_changed_previously_removed_amount_requires_review(self):
+        raw = snapshot()
+        next(i for i in raw["items"] if i["item_key"] == "monthly_malus")["amount_value"] = -600
+        with self.assertRaisesRegex(ValueError, "Ellenőrzés"):
+            carry_forward_worksheet_changes(raw, edited_snapshot())
+
+    def test_duplicate_source_rows_remove_one_occurrence(self):
+        raw = snapshot()
+        next(i for i in raw["items"] if i["item_key"] == "monthly_malus")["amount_value"] = -1000
+        raw["items"].extend([{"section": "finance", "item_key": "kiflis_malus_" + str(n), "item_label": "Késés",
+                             "amount_value": -500, "amount_kind": "huf", "note": "Ugyanaz"} for n in [1, 2]])
+        groups = worksheet_groups(raw)
+        groups[0]["items"].remove(next(i for i in groups[0]["items"] if i["amountHuf"] == -500))
+        previous = {**raw, **prepare_group_worksheet(raw, groups, "Egy kivétel")["prepared"], "id": "edit"}
+        self.assertEqual(values(carry_forward_worksheet_changes(raw, previous))["monthly_malus"], -500)
+
+    def test_removing_manual_addition_stays_removed_after_next_import(self):
+        first = carry_forward_worksheet_changes(snapshot(), edited_snapshot())
+        groups = worksheet_groups(first)
+        groups[1]["items"] = [i for i in groups[1]["items"] if i["id"] != "new-1"]
+        previous = {**first, **prepare_group_worksheet(first, groups, "Jutalom visszavonása")["prepared"], "id": "edit-2"}
+        saved = carry_forward_worksheet_changes(snapshot(), previous)
+        self.assertEqual(values(saved)["manual_bonus"], 1000)
+        self.assertEqual(values(saved)["monthly_malus"], 0)
+
+    def test_effective_reserve_update_keeps_ledger_without_reapplying(self):
+        previous = edited_snapshot()
+        candidate = deepcopy(previous)
+        candidate["metadata"]["worksheet_effective_base_snapshot_id"] = previous["id"]
+        candidate["metadata"]["source"] = "devtest.reserve_release"
+        candidate["items"].append({"section": "finance", "item_key": "reserve_payment_credit", "amount_value": 1000})
+        effective = carry_forward_worksheet_changes(candidate, previous)
+        self.assertEqual(values(effective)["manual_bonus"], 3500)
+        self.assertEqual(values(effective)["reserve_payment_credit"], 1000)
+        with self.assertRaises(ValueError):
+            carry_forward_worksheet_changes(candidate, {**previous, "id": "newer"})
+
+    def test_no_adjustment_leaves_import_unchanged_and_other_scope_is_rejected(self):
+        raw = snapshot()
+        self.assertEqual(carry_forward_worksheet_changes(raw, raw), raw)
+        for changed in [{"courier_id": "other"}, {"period_start": "2026-10-01"}]:
+            with self.assertRaises(ValueError):
+                carry_forward_worksheet_changes({**raw, **changed}, edited_snapshot())
+
+    def test_devtest_uses_same_ledger_details_and_totals(self):
+        saved = carry_forward_worksheet_changes(snapshot(), edited_snapshot())
+        details = snapshot_manual_adjustment_details(saved, "JITT bónusz / malus")
+        self.assertEqual(sum(i["Összeg"] for i in details), 3500)
+        self.assertTrue(any(i["Tétel"] == "JITT jutalom" for i in details))
+        tree = ast.parse(Path('devtest.py').read_text(encoding='utf-8'))
+        names = {"_snapshot_amount", "finance_snapshot_display_row"}
+        ns = {"parse_huf_value": lambda v: float(v or 0)}
+        exec(compile(ast.Module(body=[n for n in tree.body if isinstance(n, ast.FunctionDef) and n.name in names], type_ignores=[]), 'devtest.py', 'exec'), ns)
+        row = ns['finance_snapshot_display_row']({}, saved)
+        self.assertEqual(row['Kifizetendő'], values(saved)['payable'])
+        self.assertEqual(row['JITT bónusz'], 3500)
+        self.assertEqual(row['Korrekció'], 9000)
+
+
+class SnapshotPublisherTest(unittest.TestCase):
+    def client(self, latest=None):
+        client = Mock()
+        def table(name):
+            query = Mock()
+            for operation in ['select', 'eq', 'order', 'limit', 'range', 'in_']:
+                getattr(query, operation).return_value = query
+            rows = ([{k: v for k,v in latest.items() if k not in {'items','sources'}}] if latest else []) if name == 'courier_finance_snapshot' else (latest['items'] if name.endswith('_item') else latest['sources'])
+            query.execute.return_value = SimpleNamespace(data=rows)
+            return query
+        client.table.side_effect = table
+        client.rpc.return_value.execute.return_value = SimpleNamespace(data={"ok": True, "snapshotId": "saved", "version": 12})
+        return client
+
+    def test_import_uses_fresh_scoped_reads_and_one_atomic_rpc(self):
+        client = self.client(edited_snapshot())
+        result = save_imported_finance_snapshot(client, snapshot(), 'admin')
+        self.assertTrue(result['saved'])
+        name, payload = client.rpc.call_args.args
+        self.assertEqual(name, 'commit_imported_finance_snapshot')
+        self.assertEqual(payload['p_base_snapshot_id'], 'pwa-edit')
+        self.assertEqual(payload['p_courier_id'], '12345')
+        self.assertEqual(values(payload['p_prepared'])['manual_bonus'], 3500)
+        client.rpc.assert_called_once()
+        self.assertNotIn('courier_finance_snapshot_item', [c.args[0] for c in client.table.call_args_list])
+
+    def test_no_partial_write_or_retry_on_rpc_failure(self):
+        client = self.client(edited_snapshot())
+        client.rpc.return_value.execute.side_effect = RuntimeError('version conflict')
+        with self.assertRaisesRegex(RuntimeError, 'version conflict'):
+            save_imported_finance_snapshot(client, snapshot(), 'admin')
+        client.rpc.assert_called_once()
+
+    def test_first_import_and_identical_import_use_same_transaction(self):
+        client = self.client()
+        save_imported_finance_snapshot(client, snapshot(), 'admin')
+        self.assertIsNone(client.rpc.call_args.args[1]['p_base_snapshot_id'])
+        client.rpc.return_value.execute.return_value = SimpleNamespace(data={"ok": True, "snapshotId": "saved", "version": 12, "unchanged": True})
+        result = save_imported_finance_snapshot(client, snapshot(), 'admin')
+        self.assertTrue(result['unchanged'])
+        self.assertFalse(result['saved'])
+
+
+if __name__ == '__main__':
+    unittest.main()
