+        drilldowns["Korrekció" if group["key"] == "corrections" else group["label"]] = rows
+    for group in clean:
+        prefixes = EDIT_GROUPS[group["key"]][2]
+        for n, row in enumerate(group["items"]):
+            prefix = prefixes[0] if row["amountHuf"] >= 0 or len(prefixes) == 1 else prefixes[1]
+            prepared["items"].append({"section": "finance", "item_key": prefix + "ledger_" + str(n),
