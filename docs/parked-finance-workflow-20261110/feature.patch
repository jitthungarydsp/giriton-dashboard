+"""Publish imports atomically, retaining the latest PWA item adjustments."""
+from copy import deepcopy
+import hashlib
+import json
+
+from resources.pwa_finance_worksheet import carry_forward_worksheet_changes
+
+
+def _snapshot_children(client, table, snapshot_id, *, source_keys=None):
+    rows = []
+    while True:
+        query = client.table(table).select("source_key,payload" if source_keys else "*").eq("snapshot_id", snapshot_id)
+        if source_keys:
+            query = query.in_("source_key", source_keys)
+        page = query.order("id").range(len(rows), len(rows) + 999).execute().data or []
+        rows.extend(page)
+        if len(page) < 1000:
+            return rows
+
+
+def save_imported_finance_snapshot(client, candidate, actor):
+    """No cached reads, partial inserts, silent fallbacks or conflict retries."""
+    rows = (client.table("courier_finance_snapshot").select("*")
+            .eq("courier_id", str(candidate["courier_id"]))
+            .eq("period_start", str(candidate["period_start"])[:10])
+            .order("version", desc=True).limit(1).execute().data or [])
+    latest = dict(rows[0]) if rows else {}
+    if latest:
+        latest["sources"] = _snapshot_children(client, "courier_finance_snapshot_source", latest["id"],
+                                               source_keys=["pwa_worksheet_overrides", "pwa_worksheet_group_items"])
+        # Fresh imports need only the small change log, not old route data or
+        # finance rows. Reserve updates additionally verify effective components.
+        if any(s.get("source_key") == "pwa_worksheet_group_items" for s in candidate["sources"]):
+            latest["items"] = _snapshot_children(client, "courier_finance_snapshot_item", latest["id"])
+    effective = carry_forward_worksheet_changes(candidate, latest) if latest else deepcopy(candidate)
+    for n, item in enumerate(effective["items"], 1):
+        item["display_order"] = int(item.get("display_order") or n)
+    canonical = {k: effective.get(k) for k in ("courier_id", "period_start", "calculation_mode", "warehouse_label", "session_id", "metadata")}
+    canonical["items"] = sorted(effective["items"], key=lambda r: (r["section"], r["item_key"]))
+    canonical["sources"] = sorted(effective["sources"], key=lambda r: r["source_key"])
+    fingerprint = hashlib.sha256(json.dumps(canonical, sort_keys=True, ensure_ascii=False, default=str).encode()).hexdigest()
+    response = client.rpc("commit_imported_finance_snapshot", {
+        "p_courier_id": str(candidate["courier_id"]), "p_period_start": str(candidate["period_start"])[:10],
+        "p_base_snapshot_id": str(latest["id"]) if latest else None,
+        "p_fingerprint": fingerprint, "p_actor": str(actor),
+        "p_header": {k: effective.get(k) for k in ("courier_name", "calculation_mode", "warehouse_label", "session_id")},
+        "p_prepared": {k: effective[k] for k in ("items", "sources", "metadata")},
+    }).execute().data
+    if not isinstance(response, dict) or not response.get("ok"):
+        raise RuntimeError("A közös pénzügyi snapshot mentése nem igazolható.")
+    return {"saved": not response.get("unchanged", False), "unchanged": bool(response.get("unchanged")),
+            "version": response["version"], "snapshot_id": str(response["snapshotId"]),
+            "totals": {k: effective["metadata"].get(k) for k in
+                       ("income_total", "deduction_total", "correction_total", "payable_total")}}
