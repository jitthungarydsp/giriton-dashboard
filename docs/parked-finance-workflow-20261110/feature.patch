+def prepare_group_worksheet(snapshot, groups, note):
+    """Only additions/removals in the three allowed ledgers; saved entries are immutable."""
+    baseline = worksheet_groups(snapshot)
+    if not isinstance(groups, list) or len(groups) != len(EDIT_GROUPS):
+        raise ValueError("Mindhárom tételcsoport megadása kötelező.")
+    existing = {g["key"]: {i["id"]: i for i in g["items"]} for g in baseline}
+    clean, seen = [], set()
